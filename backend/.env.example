# Secret key used to authorize protected Grizz API endpoints (/portfolio/stats, streaming chat)
INTERNAL_API_KEY=your-internal-api-key-here

# Environment configuration (dev | prod | development)
NODE_ENV=development

# AWS Region
AWS_REGION=us-east-1

# Tables and Bedrock Configuration
DOCUMENTS_TABLE=
PORTFOLIO_USERS_TABLE=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
KNOWLEDGE_BASE_ID=

# Autonomous Remediation Webhook Daemon & Zero-Cost Ingress (GL-55 / GL-58)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here
DAEMON_PORT=8080
MOCK_LLM=true
