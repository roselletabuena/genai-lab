{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RemediationJobAuditRecord",
  "description": "Schema for machine-readable audit log envelopes persisted to --audit-dir/<job_id>.json",
  "type": "object",
  "required": [
    "job_id",
    "repo_full_name",
    "pull_request_number",
    "commit_sha",
    "status",
    "exit_code",
    "duration_ms",
    "timed_out",
    "timestamp"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "repo_full_name": {
      "type": "string"
    },
    "pull_request_number": {
      "type": "integer"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "target_branch": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["Completed", "Failed", "TimedOut"]
    },
    "exit_code": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "timed_out": {
      "type": "boolean"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
