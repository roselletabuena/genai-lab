{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genai-lab/specs/003/feedback-report.schema.json",
  "title": "FeedbackReport",
  "description": "Result contract between the remediation agent formatter and the Go supervisor GitHub client.",
  "type": "object",
  "required": ["schema_version", "verdict", "job_id", "session_id", "diagnosis", "duration_ms", "attempts", "markdown_body"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "verdict": { "enum": ["verified_fix", "no_change_needed", "failed"] },
    "job_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "diagnosis": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "attempts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["attempt_number", "outcome", "duration_ms"],
        "properties": {
          "attempt_number": { "type": "integer", "minimum": 1, "maximum": 3 },
          "outcome": { "enum": ["verified_success", "verified_failure", "failed_to_apply"] },
          "failure_reason": { "type": ["string", "null"] },
          "duration_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "markdown_body": { "type": "string", "maxLength": 60000 }
  },
  "oneOf": [
    {
      "properties": {
        "verdict": { "const": "verified_fix" },
        "test_log": { "type": "string" },
        "diff": {
          "type": "object",
          "required": ["unified_diff", "target_files"],
          "properties": {
            "unified_diff": { "type": "string", "minLength": 1 },
            "target_files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "commit_url": { "type": ["string", "null"], "format": "uri" }
          },
          "additionalProperties": false
        },
        "suggestion": {
          "type": ["object", "null"],
          "required": ["path", "start_line", "line", "replacement"],
          "properties": {
            "path": { "type": "string" },
            "start_line": { "type": "integer", "minimum": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "replacement": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "required": ["diff", "test_log"]
    },
    {
      "properties": {
        "verdict": { "const": "no_change_needed" },
        "test_log": { "type": "string" },
        "diff": false,
        "suggestion": false
      },
      "required": ["test_log"]
    },
    {
      "properties": {
        "verdict": { "const": "failed" },
        "diff": false,
        "suggestion": false,
        "test_log": false
      }
    }
  ]
}

